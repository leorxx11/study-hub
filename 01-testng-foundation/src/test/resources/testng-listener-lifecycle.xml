<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TestNG listener lifecycle suite">
    <listeners>
        <listener class-name="listener.ExecutionLifecycleListener"/>
        <listener class-name="listener.MethodTraceListener"/>
        <listener class-name="listener.MyTestListener"/>
    </listeners>

    <test name="Observe listener scopes">
        <classes>
            <class name="com.studyhub.order.advanced.OrderListenerLifecycleExample"/>
        </classes>
    </test>
</suite>
